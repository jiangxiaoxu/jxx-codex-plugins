{
  "name": "@jxx-codex-plugins/figma-mcp-stdio",
  "version": "0.1.0",
  "description": "Stdio MCP frontend for the official Figma remote MCP.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./repl": {
      "types": "./dist/repl-server.d.ts",
      "import": "./dist/repl-server.js",
      "default": "./dist/repl-server.js"
    },
    "./node-repl": {
      "types": "./dist/node-repl.d.ts",
      "import": "./dist/node-repl.js",
      "default": "./dist/node-repl.js"
    }
  },
  "bin": {
    "figma-mcp-stdio-bridge": "./dist/stdio-cli.js",
    "figma-repl-mcp": "./dist/repl-stdio-cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "acorn": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.27.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
