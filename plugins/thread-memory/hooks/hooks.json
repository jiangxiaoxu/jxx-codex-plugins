{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "& \"$env:PLUGIN_ROOT/bin/Thread-Memory-Hook.exe\"",
            "timeout": 10,
            "statusMessage": "Checking thread memory"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "& \"$env:PLUGIN_ROOT/bin/Thread-Memory-Hook.exe\"",
            "timeout": 10,
            "statusMessage": "Checking subagent thread memory"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "& \"$env:PLUGIN_ROOT/bin/Thread-Memory-Hook.exe\"",
            "timeout": 10,
            "statusMessage": "Recording subagent compaction"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "& \"$env:PLUGIN_ROOT/bin/Thread-Memory-Hook.exe\"",
            "timeout": 10,
            "statusMessage": "Checking for a context handoff"
          }
        ]
      }
    ]
  }
}
